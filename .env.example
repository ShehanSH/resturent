# Public (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never put this in client code or commit it
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# SMS — leave disabled until Text.lk (or similar) is configured.
# 1. Create an account at https://text.lk and buy SMS credits.
# 2. Request a Sender ID (max 11 characters, e.g. HotBread).
# 3. Copy the API token from the Text.lk dashboard.
# 4. Set the values below and restart the app.
# Tracking links in SMS use NEXT_PUBLIC_SITE_URL — use your live domain, not localhost.
SMS_PROVIDER=disabled
SMS_API_URL=https://app.text.lk/api/v3/sms/send
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_DEFAULT_COUNTRY_CODE=94

ORDER_RATE_LIMIT_PER_HOUR=10
